# Copy to .env.local. Demo orders make NO external payments or email requests.
# The protected /email-test tool can explicitly send a test in either mode.
APP_MODE=demo
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Neon dashboard -> Connect -> pooled PostgreSQL connection string
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server only. Start with Paystack test credentials.
PAYSTACK_SECRET_KEY=
# Mailgun US: https://api.mailgun.net, EU: https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_FROM=Kora <orders@yourdomain.com>
# Verified store owner email. On Sites this uses dispatcher identity;
# on another host it requires a verified Google session. Demo logins do not qualify.
EMAIL_TEST_OWNER_EMAIL=
# Verified owner identity used to manage shipment updates (defaults to EMAIL_TEST_OWNER_EMAIL).
STORE_OWNER_EMAIL=
# Set your canonical HTTPS origin in production; never trust request headers.
APP_URL=http://localhost:3000
# Protects the optional scheduled email retry endpoint.
CRON_SECRET=
